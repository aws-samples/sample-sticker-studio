# Staging Environment Configuration
# AWS Sticker Studio - Staging Environment

# Environment Settings
ENVIRONMENT=staging
AWS_DEFAULT_REGION=us-east-1

# Resource Configuration
RESOURCE_PREFIX=StickerStudio
COGNITO_DOMAIN_PREFIX=sticker-studio-staging

# Optional: Custom Domain Configuration
# Uncomment and set these for custom domain support
# DOMAIN_NAME=staging-stickers.example.com
# CERTIFICATE_ARN=arn:aws:acm:us-east-1:123456789012:certificate/12345678-1234-1234-1234-123456789012

# Optional: Override default account (CDK will auto-detect if not set)
# CDK_DEFAULT_ACCOUNT=123456789012

# Staging-specific settings
# Enhanced monitoring and logging for pre-production testing

# Optional: Enable detailed monitoring
# ENABLE_DETAILED_MONITORING=true

# Optional: Extended log retention
# LOG_RETENTION_DAYS=90

# Staging Notes:
# - Can use custom domain with valid certificate
# - CORS configured for staging domain
# - Enhanced monitoring for testing
# - Longer log retention than development
# - Similar to production but with relaxed security policies