# Production Environment Configuration
# AWS Sticker Studio - Production Environment

# Environment Settings
ENVIRONMENT=prod
AWS_DEFAULT_REGION=us-east-1

# Resource Configuration
RESOURCE_PREFIX=StickerStudio
COGNITO_DOMAIN_PREFIX=sticker-studio-prod

# REQUIRED: Custom Domain Configuration
# These are mandatory for production deployment
DOMAIN_NAME=stickers.example.com
CERTIFICATE_ARN=arn:aws:acm:us-east-1:123456789012:certificate/12345678-1234-1234-1234-123456789012

# Optional: Override default account (CDK will auto-detect if not set)
# CDK_DEFAULT_ACCOUNT=123456789012

# Production Security Settings
# WAF and Shield are automatically enabled for production

# Production Monitoring Settings
# Enhanced monitoring and extended log retention
LOG_RETENTION_DAYS=365
ENABLE_DETAILED_MONITORING=true
ENABLE_XRAY=true

# Production Notes:
# - Custom domain and certificate are REQUIRED
# - CORS restricted to production domain only
# - WAF protection enabled automatically
# - Extended log retention (1 year)
# - Detailed monitoring and X-Ray tracing enabled
# - All security best practices enforced

# Security Checklist for Production:
# □ Valid SSL certificate configured
# □ Custom domain DNS configured
# □ WAF rules reviewed and tested
# □ IAM policies follow least privilege
# □ All data encrypted at rest and in transit
# □ Monitoring and alerting configured
# □ Backup and disaster recovery plan in place