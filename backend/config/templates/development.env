# Development Environment Configuration
# AWS Sticker Studio - Development Environment

# Environment Settings
ENVIRONMENT=dev
AWS_DEFAULT_REGION=us-east-1

# Resource Configuration
RESOURCE_PREFIX=StickerStudio
COGNITO_DOMAIN_PREFIX=sticker-studio-dev

# Development-specific settings
# Note: Development uses localhost URLs for testing
# No custom domain or certificate required

# Optional: Override default account (CDK will auto-detect if not set)
# CDK_DEFAULT_ACCOUNT=123456789012

# Optional: Skip frontend build during development
# SKIP_FRONTEND_BUILD=true

# Optional: Enable debug logging
# CDK_DEBUG=true
# DEBUG=true

# Development Notes:
# - Uses http://localhost:3000 for Cognito callbacks
# - CORS allows localhost origins
# - No WAF or Shield protection
# - Shorter log retention (30 days)
# - Basic monitoring enabled